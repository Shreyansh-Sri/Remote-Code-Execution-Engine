# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=
MONGO_DB_NAME=codearena

# JWT Secret Key
JWT_SECRET_KEY=codearena-super-secret-jwt-key-2026-production

# Redis URL (default localhost:6379)
REDIS_URL=redis://localhost:6379

